<https://w3id.org/enhanza/column#> a owl:Ontology ;
    rdfs:comment """What each conformed column means. A column carries independent
facets — role, additivity, PII class, unit, closed domain — because it is several
things at once and no single hierarchy can hold all of them. Additivity and PII are
decisions recorded by a human, not derivations: a measure summed at the wrong grain
double-counts while every test passes."""@en .

conn:ConformedColumn a owl:Class ;
    rdfs:label "Conformed column"@en ;
    rdfs:comment "A column whose meaning is the same in every connector that supplies it."@en .

conn:role a owl:DatatypeProperty ;
    rdfs:label "role"@en ;
    rdfs:comment "identifier, measure, dimension, timestamp, flag, or text"@en ;
    rdfs:domain conn:ConformedColumn .

conn:additivity a owl:DatatypeProperty ;
    rdfs:label "additivity"@en ;
    rdfs:comment "additive, semi-additive, or non-additive — whether SUM() over this column is meaningful, and across which dimensions"@en ;
    rdfs:domain conn:ConformedColumn .

conn:pii a owl:DatatypeProperty ;
    rdfs:label "PII class"@en ;
    rdfs:comment "none, direct, quasi, or indirect — the remedies differ, so the class is recorded rather than a boolean"@en ;
    rdfs:domain conn:ConformedColumn .

conn:unit a owl:DatatypeProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "what the number counts: currency, quantity, percent, duration"@en ;
    rdfs:domain conn:ConformedColumn .

conn:domainValue a owl:DatatypeProperty ;
    rdfs:label "closed-domain value"@en ;
    rdfs:comment "one permitted value of a closed domain"@en ;
    rdfs:domain conn:ConformedColumn .

conn:domainSource a owl:DatatypeProperty ;
    rdfs:label "closed-domain source"@en ;
    rdfs:comment "where the permitted values were read from; an enum nobody can cite is invented"@en ;
    rdfs:domain conn:ConformedColumn .

conn:carriedBy a owl:DatatypeProperty ;
    rdfs:label "carried by"@en ;
    rdfs:comment "how many connectors supply this column"@en ;
    rdfs:domain conn:ConformedColumn .

