   "alias": "stg_shopify__orders",
   "description": "One row per Shopify order, renamed and cast. Soft deletes excluded.",
   "raw_code": "with source as (\n    select * from {{ source('shopify', 'orders') }}\n),\nrenamed as (\n    select\n        id                            as order_id,\n        customer_id,\n        lower(trim(financial_status)) as payment_status,\n        cast(total_price as numeric)  as order_amount,\n        coalesce(test, false)         as is_test_order,\n        cast(created_at as timestamp) as ordered_at,\n        _fivetran_synced              as _loaded_at\n    from source\n    where not coalesce(_fivetran_deleted, false)\n)\nselect * from renamed",
   "columns": {
    "order_id": {
     "description": "Primary key. Shopify order id.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "customer_id": {
     "description": "FK to customers. Null for guest checkouts.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "payment_status": {
     "description": "Lowercased financial_status.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "order_amount": {
     "description": "Gross order amount, source currency.",
     "data_type": "numeric(28,6)",
     "meta": {},
     "tags": []
    },
    "is_test_order": {
     "description": "True for Shopify test orders.",
     "data_type": "boolean",
     "meta": {},
     "tags": []
    },
    "ordered_at": {
     "description": "Order creation timestamp, UTC.",
