  "model.analytics.int_orders_with_line_totals": {
   "unique_id": "model.analytics.int_orders_with_line_totals",
   "name": "int_orders_with_line_totals",
   "resource_type": "model",
   "package_name": "analytics",
   "path": "intermediate/finance/int_orders_with_line_totals.sql",
   "original_file_path": "models/intermediate/finance/int_orders_with_line_totals.sql",
   "database": "ANALYTICS",
   "schema": "intermediate",
   "alias": "int_orders_with_line_totals",
   "description": "One row per non-test order, with line-item totals collapsed to the order grain before joining. Resolves the line-item fan-out.",
   "raw_code": "with orders as (\n    select * from {{ ref('stg_shopify__orders') }}\n),\nline_items as (\n    select * from {{ ref('stg_shopify__order_lines') }}\n),\nline_totals as (\n    select\n        order_id,\n        count(*)             as line_item_count,\n        sum(line_amount)     as gross_line_amount,\n        sum(discount_amount) as discount_amount\n    from line_items\n    group by 1\n),\nfinal as (\n    select\n        orders.order_id,\n        orders.customer_id,\n        orders.ordered_at,\n        orders.order_amount,\n        case\n            when orders.payment_status = 'refunded' then 'refunded'\n            when orders.payment_status = 'paid'     then 'paid'\n            when orders.payment_status is null      then 'unknown'\n            else orders.payment_status\n        end as order_status,\n        coalesce(line_totals.line_item_count, 0)   as line_item_count,\n        coalesce(line_totals.gross_line_amount, 0) as gross_line_amount,\n        coalesce(line_totals.discount_amount, 0)   as discount_amount\n    from orders\n    left join line_totals on orders.order_id = line_totals.order_id\n    where not orders.is_test_order\n)\nselect * from final",
   "columns": {
    "order_id": {
     "description": "Primary key.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "customer_id": {
     "description": "FK to dim_customers.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "ordered_at": {
     "description": "Order timestamp, UTC.",
     "data_type": "timestamp",
     "meta": {},
     "tags": []
    },
    "order_amount": {
     "description": "Gross order amount.",
     "data_type": "numeric(28,6)",
     "meta": {},
     "tags": []
    },
    "order_status": {
     "description": "Business status; refund overrides fulfillment.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "line_item_count": {
     "description": "Number of line items.",
     "data_type": "integer",
     "meta": {},
     "tags": []
    },
    "gross_line_amount": {
     "description": "Sum of line amounts.",
     "data_type": "numeric(28,6)",
     "meta": {},
     "tags": []
    },
    "discount_amount": {
     "description": "Sum of line discounts.",
     "data_type": "numeric(28,6)",
     "meta": {},
     "tags": []
    }
   },
   "config": {
    "materialized": "ephemeral",
    "tags": [
     "intermediate"
    ],
    "enabled": true
   },
   "depends_on": {
    "nodes": [
     "model.analytics.stg_shopify__orders",
     "model.analytics.stg_shopify__order_lines"
    ],
    "macros": []
   },
   "tags": [
    "intermediate"
   ]
  },
