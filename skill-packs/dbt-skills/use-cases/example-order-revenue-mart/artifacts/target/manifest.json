  "model.analytics.fct_orders": {
   "unique_id": "model.analytics.fct_orders",
   "name": "fct_orders",
   "resource_type": "model",
   "package_name": "analytics",
   "path": "marts/finance/fct_orders.sql",
   "original_file_path": "models/marts/finance/fct_orders.sql",
   "database": "ANALYTICS",
   "schema": "marts",
   "alias": "fct_orders",
   "description": "One row per order at its current status. Excludes internal test accounts. Amounts are USD at the order-date rate.",
   "raw_code": "with orders as (\n    select * from {{ ref('int_orders_with_line_totals') }}\n    {% if is_incremental() %}\n    where ordered_at >= (select dateadd(day, -3, max(ordered_at)) from {{ this }})\n    {% endif %}\n),\ncustomers as (\n    select * from {{ ref('dim_customers') }}\n),\nfinal as (\n    select\n        orders.order_id,\n        orders.customer_id,\n        customers.region,\n        orders.order_status,\n        orders.line_item_count,\n        orders.order_amount                                as order_amount_usd,\n        orders.gross_line_amount - orders.discount_amount  as net_line_amount_usd,\n        orders.ordered_at,\n        cast(orders.ordered_at as date)                    as ordered_date\n    from orders\n    left join customers on orders.customer_id = customers.customer_id\n)\nselect * from final",
   "columns": {
    "order_id": {
     "description": "Primary key. Shopify order id.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "customer_id": {
     "description": "FK to dim_customers. Null for guest checkouts.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "region": {
     "description": "Customer region at time of query.",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "order_status": {
     "description": "pending|paid|fulfilled|refunded|cancelled",
     "data_type": "varchar",
     "meta": {},
     "tags": []
    },
    "line_item_count": {
     "description": "Number of line items.",
     "data_type": "integer",
     "meta": {},
     "tags": []
    },
    "order_amount_usd": {
     "description": "Gross order amount, USD.",
     "data_type": "numeric(28,6)",
     "meta": {},
     "tags": []
    },
    "net_line_amount_usd": {
     "description": "Line totals less discounts, USD.",
     "data_type": "numeric(28,6)",
     "meta": {},
     "tags": []
    },
    "ordered_at": {
     "description": "Order timestamp, UTC.",
     "data_type": "timestamp",
     "meta": {},
     "tags": []
    },
    "ordered_date": {
     "description": "Order date, UTC.",
     "data_type": "date",
     "meta": {},
     "tags": []
    }
   },
   "config": {
    "materialized": "incremental",
    "tags": [
     "marts"
