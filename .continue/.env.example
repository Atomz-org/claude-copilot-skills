# Copy this file to .continue/.env.local for machine-specific overrides.
# continue2.sh loads .continue/.env first, then .continue/.env.local.

# Router listener for the local OpenAI-compatible proxy.
ROUTER_PORT=4000

# Upstream MLX server that the router forwards to.
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8080

# Default local model identifier passed to the router and MLX server.
LOCAL_MODEL=mlx-community/Qwen3.5-4B-MLX-8bit

# MLX server binary and bind host.
MLX_BIN=/Users/sswaminathan/Documents/claude-data-skills/code-skills/.venv/bin/mlx_lm.server
MLX_HOST=127.0.0.1

# Full launch command override. Keep this quoted if you add extra flags.
MLX_CMD="$MLX_BIN --model $LOCAL_MODEL --host $MLX_HOST --port $UPSTREAM_PORT"

# Router request budgets.
HARD_REQUEST_BYTES=3000000
HARD_INPUT_TOKENS=24000
DISABLE_STREAM_OVER_TOKENS=10000

# Higher request budgets for make run-cline.
CLINE_HARD_REQUEST_BYTES=5000000
CLINE_HARD_INPUT_TOKENS=36000
CLINE_DISABLE_STREAM_OVER_TOKENS=14000